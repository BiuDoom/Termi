    "“%@” is not a regular file. Upload to a regular file instead of replacing a link or special file." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”不是普通文件。请上传到普通文件，不要替换链接或特殊文件。"
          }
        }
      }
    },
    "“%@” on the server is a link or a file, not a folder. The upload stopped rather than write through it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
