    },
    "The Docker command failed and the host gave no reason." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Docker 命令执行失败，主机没有给出原因。"
          }
        }
      }
    },
    "The folders below “%@” are nested more than %lld levels deep. The operation was stopped." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”下面的文件夹嵌套超过 %2$lld 层，操作已停止。"
          }
        }
      }
    },
    "The host key of “%@” has changed" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”的主机密钥已变更"
          }
        }
      }
    },
    "The host key of %@ has changed. This could mean the server was reinstalled — or that someone is intercepting the connection. Remove the old key under Known Hosts only if you trust this change." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的主机密钥已更改。这可能是服务器被重装了——也可能有人正在拦截连接。只有在你信任此变更时，才去“已知主机”中移除旧密钥。"
          }
        }
      }
    },
    "The host key of %@ was not trusted." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未信任 %@ 的主机密钥。"
          }
        }
      }
    },
    "The host name could not be resolved" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法解析主机名"
          }
        }
      }
    },
    "The jump hosts of %@ form a loop." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的跳板机形成了循环。"
          }
        }
      }
    },
    "The key is appended to ~/.ssh/authorized_keys on each selected host (once). You may be asked for the host's password." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公钥会追加到每台所选主机的 ~/.ssh/authorized_keys（不会重复）。可能会要求输入主机密码。"
          }
        }
      }
    },
    "The key's passphrase is saved with the key, not here." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密钥的密码短语随密钥保存，不在这里填写。"
          }
        }
      }
    },
    "The latest %lld of %lld matches are listed" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这里列出最近 %1$lld 条，共 %2$lld 条匹配"
          }
        }
      }
    },
    "The latest %lld of %lld records are listed" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这里列出最近 %1$lld 条，共 %2$lld 条"
          }
        }
      }
    },
    "The master password encrypts your saved passwords and SSH keys. It cannot be recovered if you forget it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主密码用于加密已保存的密码和 SSH 密钥。忘记后无法找回。"
          }
        }
      }
    },
    "The name “%@” is already taken. Choose a different name." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名称“%@”已被使用，请换一个名称。"
          }
        }
      }
    },
    "The operation could not be completed" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法完成操作"
          }
        }
      }
    },
    "The passphrase cannot contain line breaks or be longer than 1023 bytes." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密码短语不能包含换行，长度也不能超过 1023 字节。"
          }
        }
      }
    },
    "The permissions of “%@” cannot be changed: it is a link, and what it points to cannot be read (%@)." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法更改“%1$@”的权限：它是一个链接，而它指向的项目无法读取（%2$@）。"
          }
        }
      }
    },
    "The previous database was kept at %@." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原数据库已保留在 %@。"
          }
        }
      }
    },
    "The private key configured for %@ no longer exists." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为 %@ 配置的私钥已不存在。"
          }
        }
      }
    },
    "The saved password of the identity “%@” cannot be decrypted on this Mac. Enter it again under Identities." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "身份“%@”保存的密码在这台 Mac 上无法解密。请在“身份”中重新输入。"
          }
        }
      }
    },
    "The saved private key “%@” cannot be decrypted on this Mac. Import the key again in Keychain." : {
      "localizations" : {
        "zh-Hans" : {
